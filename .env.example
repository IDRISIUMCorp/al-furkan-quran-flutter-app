# Firebase Configuration (optional — core features work offline)
# Copy this file to .env and fill in your values

# Firebase Web Config (only needed for web deployment)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Service Account (for admin features)
# Place your service account key JSON at:
# lib/core/constants/service_account_key.dart
# This file is already gitignored — NEVER commit it

# Note: Android and iOS Firebase configs are handled via:
# - android/app/google-services.json (gitignored)
# - ios/Runner/GoogleService-Info.plist (gitignored)
